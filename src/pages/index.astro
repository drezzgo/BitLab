---
import BaseLayout from '../layouts/BaseLayout.astro';
import BitLabWorkbench from '../components/react/BitLabWorkbench';
---
<BaseLayout
  title="BitLab · Adaptive Compression Lab"
  description="BitLab: laboratorio web de compresión reversible y optimización progresiva de archivos."
>
  <header class="topbar">
    <a class="brand" href="#inicio"><span class="brand-mark">01</span><span>bitlab</span></a>
    <nav aria-label="Principal">
      <a href="#herramienta"><span>Compresor</span></a>
      <a href="#mejoras"><span>Mejoras</span></a>
      <a href="#analisis"><span>Análisis</span></a>
      <a href="#benchmark"><span>Benchmark</span></a>
      <a href="#formato-bitlab"><span>.bitlab</span></a>
    </nav>
    <span class="academic-tag">Ingeniería Telemática · UD</span>
  </header>

  <main>
    <section class="hero adaptive-hero" id="inicio">
      <div class="pixel-bits bits-left" aria-hidden="true">RAW → HUFF</div>
      <div class="pixel-bits bits-right" aria-hidden="true">SMALLER?</div>
      <p class="eyebrow">BITLAB · COMPRESIÓN ADAPTATIVA</p>
      <h1>Comprimir mejor, <span>medir cada decisión.</span></h1>
      <p>
        BitLab evoluciona desde un laboratorio de Huffman hacia un sistema de compresión adaptativa.
        BitLab compara algoritmos y configuraciones sobre el archivo real: distintos tamaños de símbolo, perfiles LZ77 y estrategias de codificación compiten por producir el menor resultado reversible.
      </p>
      <div class="hero-status" aria-label="Estado del proyecto">
        <span>LOCAL</span>
        <span>LOSSLESS</span>
        <span>HUFFMAN BASELINE</span>
        <span>RLE + HUFFMAN</span>
        <span>LZ77 + HUFFMAN</span>
        <span>PARAMETER SEARCH</span>
        <span>BENCHMARK</span>
      </div>
    </section>

    <section class="section" id="herramienta">
      <BitLabWorkbench client:load />
    </section>
  </main>

  <footer>
    <div>
      <strong>bitlab</strong>
      <p>Adaptive Compression Lab · Proyecto académico</p>
    </div>
    <span>Universidad Distrital Francisco José de Caldas · Ingeniería Telemática</span>
  </footer>
</BaseLayout>
